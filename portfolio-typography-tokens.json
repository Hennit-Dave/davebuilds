{
  "$description": "M3 type scale for portfolio site (vibecoder mono-forward pairing). JetBrains Mono handles expressive roles (display, headline, title-large); Inter handles utilitarian roles (title-medium through label-small) — same expressive/utilitarian split used in the FindAnArtisan Fraunces + Inter scale. Letter-spacing on mono roles is set to 0 rather than the M3 default negative tracking, since monospace glyphs have fixed advance width and negative tracking causes character overlap.",
  "portfolio": {
    "ref": {
      "font-family": {
        "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] },
        "sans": { "$type": "fontFamily", "$value": ["Inter", "sans-serif"] }
      },
      "font-weight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 }
      }
    },
    "sys": {
      "typography": {
        "display-large": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "57px",
            "lineHeight": "64px",
            "letterSpacing": "0px"
          },
          "$description": "Hero headline on homepage / landing"
        },
        "display-medium": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "45px",
            "lineHeight": "52px",
            "letterSpacing": "0px"
          },
          "$description": "Section-opening headline, e.g. 'Selected work'"
        },
        "display-small": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "36px",
            "lineHeight": "44px",
            "letterSpacing": "0px"
          },
          "$description": "Project case study page title"
        },
        "headline-large": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "32px",
            "lineHeight": "40px",
            "letterSpacing": "0px"
          },
          "$description": "Major section heading"
        },
        "headline-medium": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "28px",
            "lineHeight": "36px",
            "letterSpacing": "0px"
          },
          "$description": "Sub-section heading within a case study"
        },
        "headline-small": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "24px",
            "lineHeight": "32px",
            "letterSpacing": "0px"
          },
          "$description": "Card or module heading, e.g. project card title"
        },
        "title-large": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.mono}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "22px",
            "lineHeight": "28px",
            "letterSpacing": "0px"
          },
          "$description": "Emphasized inline heading, pull-quote lead-in"
        },
        "title-medium": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.medium}",
            "fontSize": "16px",
            "lineHeight": "24px",
            "letterSpacing": "0.15px"
          },
          "$description": "Nav labels, form section titles"
        },
        "title-small": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.medium}",
            "fontSize": "14px",
            "lineHeight": "20px",
            "letterSpacing": "0.1px"
          },
          "$description": "Card sub-titles, list headers"
        },
        "body-large": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "16px",
            "lineHeight": "24px",
            "letterSpacing": "0.5px"
          },
          "$description": "Primary paragraph text, case study body copy"
        },
        "body-medium": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "14px",
            "lineHeight": "20px",
            "letterSpacing": "0.25px"
          },
          "$description": "Secondary paragraph text, captions"
        },
        "body-small": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.regular}",
            "fontSize": "12px",
            "lineHeight": "16px",
            "letterSpacing": "0.4px"
          },
          "$description": "Footnotes, metadata, fine print"
        },
        "label-large": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.medium}",
            "fontSize": "14px",
            "lineHeight": "20px",
            "letterSpacing": "0.1px"
          },
          "$description": "Button labels, tab labels"
        },
        "label-medium": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.medium}",
            "fontSize": "12px",
            "lineHeight": "16px",
            "letterSpacing": "0.5px"
          },
          "$description": "Tags, badges, small buttons"
        },
        "label-small": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{portfolio.ref.font-family.sans}",
            "fontWeight": "{portfolio.ref.font-weight.medium}",
            "fontSize": "11px",
            "lineHeight": "16px",
            "letterSpacing": "0.5px"
          },
          "$description": "Timestamps, micro-labels"
        }
      }
    }
  }
}
